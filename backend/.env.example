# Copy to backend/.env (gitignored). Settings: src/banyan/config.py.
BANYAN_DATABASE_URL=postgresql+asyncpg://banyan:CHANGE_ME@localhost:5432/banyan
# Tests only: a throwaway schema `banyan_test` in this database is dropped and recreated per test.
BANYAN_TEST_DATABASE_URL=postgresql+asyncpg://banyan:CHANGE_ME@localhost:5432/banyan

# The single user's API token for /v1 (Authorization: Bearer ...); at least 16 characters.
BANYAN_API_TOKEN=          # openssl rand -hex 24

# LLM roles (design §7): see roles.example.yaml. Or BANYAN_FAKES=1 for development and frontend
# e2e: every role answers from a fake model and steward is a fake (never for real use).
# BANYAN_ROLES_FILE=roles.yaml
# BANYAN_FAKES=1
# BANYAN_FAKE_DELAY_S=0.05   # with fakes: pause between streamed chunks, to see progress

# llm-steward (design §8). Unset: /health reports steward as not_configured.
# BANYAN_STEWARD_URL=http://127.0.0.1:8600
# BANYAN_STEWARD_API_KEY=      # scopes read, write
# BANYAN_STEWARD_REVIEW_KEY=   # scope review, only to create collections and deprecate: its writes go live verified

# The web (design §7.3). Unset: no web tools, /health reports search as not_configured, and a
# time-sensitive answer is marked "may be stale".
# BANYAN_SEARCH_PROVIDER=tavily
# BANYAN_SEARCH_API_KEY=       # tvly-...
# BANYAN_ALLOW_PRIVATE_URLS=false   # local tests only: lets web_fetch reach private addresses
